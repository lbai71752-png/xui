# setup 必须与 Zerops 中已创建的 Runtime service hostname 一致；如非 app，请替换。
zerops:
  - setup: app
    build:
      base: python@3.12
      deployFiles:
        - app.py
    run:
      base: python@3.12
      ports:
        - port: 8080
          protocol: TCP
          httpSupport: true
      prepareCommands:
        - python3 -m pip install --ignore-installed "aiohttp>=3.9,<4"
      envVariables:
        PORT: "8080"
      start: python3 app.py
